# ---------------------------------------------------------------------------
# Nma's Kitchen — frontend environment configuration
# ---------------------------------------------------------------------------
# The app ships with an isolated DEVELOPMENT MOCK DATA ADAPTER so the whole
# product is usable without a backend. Point VITE_API_URL at the real backend
# to switch every service to the live HTTP transport (see src/services/client.ts).
#
# Copy this file to `.env.local` and fill in values. Never commit real secrets:
# anything prefixed with VITE_ is embedded in the client bundle.

# Leave EMPTY to use the built-in development mock adapter.
# Set to a base URL (e.g. https://api.nmaskitchen.ng/v1) to use the real API.
VITE_API_URL=

# Optional: interval (ms) used by the development order-tracking simulator
VITE_TRACKING_POLL_MS=8000
